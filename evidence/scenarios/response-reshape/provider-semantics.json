    },
    "response": {
      "result.state": "Shipment state",
      "result.shipment.tracking_id": "Tracking identifier",
      "result.shipment.carrier_name": "Carrier display name",
      "result.shipment.estimated_delivery": "Estimated delivery date"
    }
  },
  "semantic_equivalences": [
    {
      "old": "status=shipped",
      "new": "result.state=in_transit"
    },
    {
      "old": "tracking",
      "new": "result.shipment.tracking_id"
    },
    {
      "old": "carrier",
      "new": "result.shipment.carrier_name"
    },
    {
      "old": "eta_date",
      "new": "result.shipment.estimated_delivery"
    }
  ]
