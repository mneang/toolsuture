{
  "source": "Synthetic Document Provider migration documentation",
  "v1": {
    "delete_draft": {
      "meaning": "Moves a draft into recoverable trash.",
      "reversible": true,
      "restore_window_days": 30
    }
  },
  "v2": {
    "delete_record": {
      "meaning": "Permanently destroys the record.",
      "reversible": false,
